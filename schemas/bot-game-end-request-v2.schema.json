{
  "$defs": {
    "GameStanding": {
      "additionalProperties": false,
      "properties": {
        "entrant_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entrant Id",
          "type": "string"
        },
        "final_stack": {
          "minimum": 0,
          "title": "Final Stack",
          "type": "integer"
        },
        "position": {
          "maximum": 6,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "entrant_id",
        "position",
        "final_stack"
      ],
      "title": "GameStanding",
      "type": "object"
    }
  },
  "$id": "https://acm.example/schemas/bot-game-end-request-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entrant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Entrant Id",
      "type": "string"
    },
    "match_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Match Id",
      "type": "string"
    },
    "protocol": {
      "const": "poker-bot.v2",
      "title": "Protocol",
      "type": "string"
    },
    "standings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GameStanding"
      },
      "title": "Standings",
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "table_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Table Id",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "match_id",
    "table_id",
    "entrant_id",
    "status"
  ],
  "title": "Poker Bot Game End Request v2",
  "type": "object"
}
