{
  "$defs": {
    "BlindState": {
      "additionalProperties": false,
      "properties": {
        "big_blind": {
          "exclusiveMinimum": 0,
          "title": "Big Blind",
          "type": "integer"
        },
        "big_blind_ante": {
          "minimum": 0,
          "title": "Big Blind Ante",
          "type": "integer"
        },
        "small_blind": {
          "minimum": 0,
          "title": "Small Blind",
          "type": "integer"
        }
      },
      "required": [
        "small_blind",
        "big_blind",
        "big_blind_ante"
      ],
      "title": "BlindState",
      "type": "object"
    }
  },
  "$id": "https://acm.example/schemas/bot-game-start-request-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blinds": {
      "$ref": "#/$defs/BlindState"
    },
    "entrant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Entrant Id",
      "type": "string"
    },
    "match_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Match Id",
      "type": "string"
    },
    "protocol": {
      "const": "poker-bot.v2",
      "title": "Protocol",
      "type": "string"
    },
    "starting_stack": {
      "exclusiveMinimum": 0,
      "title": "Starting Stack",
      "type": "integer"
    },
    "table_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Table Id",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "match_id",
    "table_id",
    "entrant_id",
    "starting_stack",
    "blinds"
  ],
  "title": "Poker Bot Game Start Request v2",
  "type": "object"
}
