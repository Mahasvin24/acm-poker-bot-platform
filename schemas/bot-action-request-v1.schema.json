{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acm.example/schemas/bot-action-request-v1.schema.json",
  "title": "Poker Bot Action Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "tournament_id", "table_id", "hand_id", "decision_id", "table_version", "deadline_at", "table", "player", "legal_actions"],
  "properties": {
    "protocol": { "const": "poker-bot.v1" },
    "tournament_id": { "$ref": "#/$defs/identifier" },
    "table_id": { "$ref": "#/$defs/identifier" },
    "hand_id": { "$ref": "#/$defs/identifier" },
    "decision_id": { "$ref": "#/$defs/identifier" },
    "table_version": { "type": "integer", "minimum": 0 },
    "deadline_at": { "type": "string", "format": "date-time" },
    "table": { "$ref": "#/$defs/publicTable" },
    "player": { "$ref": "#/$defs/actingPlayer" },
    "legal_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/legalAction" },
      "contains": {
        "type": "object",
        "properties": { "action": { "enum": ["check", "fold"] } },
        "required": ["action"]
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "card": { "type": "string", "pattern": "^[2-9TJQKA][cdhs]$" },
    "publicSeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "entrant_id", "display_name", "kind", "stack", "committed_this_street", "committed_this_hand", "folded", "all_in", "eliminated"],
      "properties": {
        "seat": { "type": "integer", "minimum": 1, "maximum": 6 },
        "entrant_id": { "$ref": "#/$defs/identifier" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["human", "bot"] },
        "stack": { "type": "integer", "minimum": 0 },
        "committed_this_street": { "type": "integer", "minimum": 0 },
        "committed_this_hand": { "type": "integer", "minimum": 0 },
        "folded": { "type": "boolean" },
        "all_in": { "type": "boolean" },
        "eliminated": { "type": "boolean" }
      }
    },
    "publicAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "seat", "action"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "seat": { "type": "integer", "minimum": 1, "maximum": 6 },
        "action": { "enum": ["fold", "check", "call", "raise"] },
        "amount_to": { "type": ["integer", "null"], "minimum": 0 },
        "automatic": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "raise" } }, "required": ["action"] },
          "then": { "required": ["amount_to"], "properties": { "amount_to": { "type": "integer", "minimum": 0 } } },
          "else": { "properties": { "amount_to": { "type": "null" } } }
        }
      ]
    },
    "blinds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["small_blind", "big_blind", "big_blind_ante"],
      "properties": {
        "small_blind": { "type": "integer", "minimum": 0 },
        "big_blind": { "type": "integer", "exclusiveMinimum": 0 },
        "big_blind_ante": { "type": "integer", "minimum": 0 }
      }
    },
    "sidePot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "eligible_seats"],
      "properties": {
        "amount": { "type": "integer", "minimum": 0 },
        "eligible_seats": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 6 }
        }
      }
    },
    "publicTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "button_seat", "blinds", "seats", "pot"],
      "properties": {
        "street": { "enum": ["preflop", "flop", "turn", "river", "showdown", "complete"] },
        "button_seat": { "type": "integer", "minimum": 1, "maximum": 6 },
        "blinds": { "$ref": "#/$defs/blinds" },
        "community_cards": { "type": "array", "items": { "$ref": "#/$defs/card" }, "default": [] },
        "seats": { "type": "array", "items": { "$ref": "#/$defs/publicSeat" } },
        "pot": { "type": "integer", "minimum": 0 },
        "side_pots": { "type": "array", "items": { "$ref": "#/$defs/sidePot" }, "default": [] },
        "action_history": { "type": "array", "items": { "$ref": "#/$defs/publicAction" }, "default": [] }
      }
    },
    "actingPlayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "stack", "committed_this_street", "hole_cards"],
      "properties": {
        "seat": { "type": "integer", "minimum": 1, "maximum": 6 },
        "stack": { "type": "integer", "minimum": 0 },
        "committed_this_street": { "type": "integer", "minimum": 0 },
        "hole_cards": { "type": "array", "items": { "$ref": "#/$defs/card" } }
      }
    },
    "legalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "enum": ["fold", "check", "call", "raise"] },
        "amount": { "type": ["integer", "null"], "minimum": 0 },
        "min_amount_to": { "type": ["integer", "null"], "minimum": 0 },
        "max_amount_to": { "type": ["integer", "null"], "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "call" } }, "required": ["action"] },
          "then": {
            "required": ["amount"],
            "properties": {
              "amount": { "type": "integer", "minimum": 0 },
              "min_amount_to": { "type": "null" },
              "max_amount_to": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "raise" } }, "required": ["action"] },
          "then": {
            "required": ["min_amount_to", "max_amount_to"],
            "properties": {
              "amount": { "type": "null" },
              "min_amount_to": { "type": "integer", "minimum": 0 },
              "max_amount_to": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["fold", "check"] } }, "required": ["action"] },
          "then": {
            "properties": {
              "amount": { "type": "null" },
              "min_amount_to": { "type": "null" },
              "max_amount_to": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
