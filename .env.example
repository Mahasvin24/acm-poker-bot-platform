POKER_DATABASE_URL=postgresql+asyncpg://poker:poker@localhost:5432/poker
# Optional: different database for live-Postgres pytest only (defaults to POKER_DATABASE_URL)
# POKER_TEST_DATABASE_URL=postgresql+asyncpg://poker:poker@localhost:5432/poker
POKER_SECRET_KEY=replace-with-at-least-32-random-characters
POKER_PARTICIPANT_SUBNET=192.168.0.0/16
POKER_BLOCKED_IPS=192.168.1.1,192.168.1.2
# Comma-separated frontend origins; add your LAN URL for event Wi-Fi access.
POKER_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
POKER_COOKIE_SECURE=false
POKER_LOG_LEVEL=INFO
POKER_WORKER_COUNT=1
